#!/bin/bash
set -euo pipefail
# Installer passes the target volume as its third argument. The preference
# domain and bundle ID remain unchanged, so no user data needs to be moved.
TARGET_VOLUME="${3:-/}"
LEGACY_APP="${TARGET_VOLUME%/}/Applications/Time Slots.app"
CURRENT_APP="${TARGET_VOLUME%/}/Applications/Focus Slots.app"
if [ -d "$LEGACY_APP" ] && [ ! -L "$LEGACY_APP" ] && [ ! -e "$CURRENT_APP" ] && [ ! -L "$CURRENT_APP" ]; then
    LEGACY_ID="$(/usr/libexec/PlistBuddy -c 'Print CFBundleIdentifier' "$LEGACY_APP/Contents/Info.plist" 2>/dev/null || true)"
    if [ "$LEGACY_ID" = "local.timeslots.app" ]; then
        /bin/mv "$LEGACY_APP" "$CURRENT_APP"
        echo 'Renamed Time Slots to Focus Slots.'
    fi
fi
